---
import { site } from "../content/site";

const { pathname } = Astro.url;
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-cream/95 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8" aria-label="Primary navigation">
    <a href="/" class="font-display text-3xl tracking-tight text-forest">Ayatana</a>
    <div class="hidden items-center gap-8 md:flex">
      {site.navigation.map((item) => (
        <a href={item.href} class:list={["text-sm font-semibold transition hover:text-forest", pathname === item.href ? "text-forest" : "text-ink/70"]} aria-current={pathname === item.href ? "page" : undefined}>{item.label}</a>
      ))}
      <a href="/contact" class="rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-ink">Request a consultation</a>
    </div>
    <button type="button" class="hs-collapse-toggle inline-flex size-10 items-center justify-center rounded-full border border-line text-forest md:hidden" id="site-menu-toggle" aria-expanded="false" aria-controls="site-menu" data-hs-collapse="#site-menu">
      <span class="sr-only">Toggle navigation</span>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </nav>
  <div id="site-menu" class="hs-collapse hidden overflow-hidden border-t border-line md:hidden" aria-labelledby="site-menu-toggle">
    <div class="space-y-1 px-6 py-4">
      {site.navigation.map((item) => (
        <a href={item.href} class="block rounded-lg px-3 py-2 font-semibold text-ink hover:bg-sand">{item.label}</a>
      ))}
      <a href="/contact" class="mt-3 block rounded-lg bg-forest px-3 py-2 text-center font-semibold text-white">Request a consultation</a>
    </div>
  </div>
</header>
