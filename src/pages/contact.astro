---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact Ayatana | Facility Management Services" description="Start a conversation with Ayatana about your facility management needs.">
  <Header />
  <main>
    <section class="bg-sand">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-moss">Contact Ayatana</p>
        <h1 class="mt-5 max-w-3xl font-display text-5xl leading-[0.98] tracking-tight sm:text-7xl">Let’s make your workplace easier to run.</h1>
      </div>
    </section>
    <section class="mx-auto grid max-w-7xl gap-14 px-6 py-16 lg:grid-cols-[.8fr_1.2fr] lg:px-8 lg:py-24">
      <div>
        <h2 class="font-display text-3xl">Start with a conversation.</h2>
        <p class="mt-5 max-w-sm leading-7 text-ink/70">Tell us about your facility, the services you need, and the outcomes you are working toward.</p>
        <address class="mt-10 space-y-5 not-italic text-sm">
          <p><span class="block text-xs font-bold uppercase tracking-[0.16em] text-moss">Email</span><a class="mt-1 inline-block font-semibold hover:text-forest" href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><span class="block text-xs font-bold uppercase tracking-[0.16em] text-moss">Phone</span><a class="mt-1 inline-block font-semibold hover:text-forest" href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a></p>
          <p><span class="block text-xs font-bold uppercase tracking-[0.16em] text-moss">Location</span><span class="mt-1 inline-block font-semibold">{site.location}</span></p>
        </address>
      </div>
      <form action={`mailto:${site.email}`} method="post" enctype="text/plain" class="rounded-2xl border border-line bg-sand/50 p-6 sm:p-10">
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-semibold">Name<input required name="name" autocomplete="name" class="rounded-lg border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-forest" /></label>
          <label class="grid gap-2 text-sm font-semibold">Work email<input required type="email" name="email" autocomplete="email" class="rounded-lg border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-forest" /></label>
        </div>
        <label class="mt-6 grid gap-2 text-sm font-semibold">Company<input name="company" autocomplete="organization" class="rounded-lg border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-forest" /></label>
        <label class="mt-6 grid gap-2 text-sm font-semibold">How can we help?<textarea required name="message" rows="6" class="rounded-lg border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-forest"></textarea></label>
        <button type="submit" class="mt-7 rounded-full bg-forest px-6 py-3.5 font-semibold text-white transition hover:bg-ink">Send inquiry</button>
        <p class="mt-4 text-xs leading-5 text-ink/60">Submitting opens your email app with your message addressed to Ayatana. Connect a form service before production if you need browser-based submissions.</p>
      </form>
    </section>
  </main>
  <Footer />
</BaseLayout>
