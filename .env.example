# Ayatana Website Environment Variables

# API endpoint for the consultation form submission
# This should be the base URL of the Ayatana backend API
# Example: https://api.ayatana.org.in or your ngrok URL for development
# Note: This is baked into the static build at `astro build` time
# Rebuild and redeploy the website when this value changes
PUBLIC_API_URL=https://your-api-url.com
